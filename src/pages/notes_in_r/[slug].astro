---
import LegacyArticleLayout from '../../layouts/LegacyArticleLayout.astro';
import { getLegacyPages } from '../../lib/legacy-content';
export function getStaticPaths() {
  return getLegacyPages('notes_in_r').map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<LegacyArticleLayout page={page} sectionTitle="Notes in R" sectionHref="/resources/#notes" />
