---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatAuthors, publicationSlug, publicationYear } from '../../lib/publications';

export async function getStaticPaths() {
  const entries = await getCollection('publications');
  return entries.map((entry) => ({ params: { slug: publicationSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const type = entry.data.publication_types === 'manuscript' ? 'Working paper' : 'Journal article';
---

<BaseLayout title={entry.data.title} description={entry.data.abstract || `Research by Yabin Da: ${entry.data.title}`}>
  <article class="publication-page">
    <a class="back-link" href="/research/">← Back to research</a>
    <header>
      <p class="eyebrow">{type} · {publicationYear(entry.data.date)}</p>
      <h1>{entry.data.title}</h1>
      <p class="publication-page-authors">{formatAuthors(entry.data.authors)}</p>
      {entry.data.publication && <p class="publication-page-venue" set:html={String(entry.data.publication).replaceAll('*', '')} />}
      <div class="publication-actions">
        {entry.data.url_pdf && <a class="button-link" href={entry.data.url_pdf}>View paper <span aria-hidden="true">↗</span></a>}
        {entry.data.doi && <a class="text-link" href={entry.data.doi}>DOI <span aria-hidden="true">↗</span></a>}
      </div>
    </header>
    {entry.data.abstract && <section class="abstract"><p class="eyebrow">Abstract</p><p>{entry.data.abstract}</p></section>}
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
